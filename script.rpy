# ==============================================================================
# 1. 初始化持久變數與角色定義
# ==============================================================================
# 初始化輪迴次數（如果玩家是第一次玩，預設為 0）
default persistent.loop_count = 0

define mc = Character("星野 遙", color="#4b8bbe")
define sys = Character("提示", color="#aaaaaa")

# ==============================================================================
# 2. 遊戲開頭 (Game Start)
# ==============================================================================
label start:

    scene bg room with fade

    "（鬧鐘嗶嗶嗶地響起……）"

    # 判斷是否已經發生過輪迴
    if persistent.loop_count > 0:
        # 【輪迴後的特殊劇情】
				"眼睛逐漸有了光芒，耳朵也開始聽到噪音"
        mc "（猛然坐起來，大口喘氣）……哈啊……哈啊！"
        mc "這……這是我的房間？"
        mc "等一下！剛才發生的事情……難道只是夢？"
        mc "不，那種真實感……我剛才明明因為一直等手機充電，然後就沒有了"
        mc "（看著熟悉的床頭櫃）這一次不如就不帶手機了吧"
    else:
        # 【第一次進入遊戲的正常劇情】
				"（鬧鐘響起的聲音）"
        mc "嗯……已經這個時間了嗎……"
        "我迷迷糊糊地伸了個懶腰，從床上坐了起來。"
        mc "感覺做了奇怪的夢啊"
        "習慣性地，我順手摸向床頭櫃，準備拿起手機……"

    "眼前這部手機型號已經很舊了，但陪我多年，所以一直留在身邊"
    "（按下開關掣）但螢幕還是一片黑的"
    "（隨後嘗試了多次也一樣）"
    mc "不會吧……昨晚忘記插電源線充電了？！"
		mc "並充電這種事情也忘記，我的腦袋沒有救了"
       "這下該怎麼辦？就算等手機充電也沒多少電還不如直接出門"
       "但是路上就沒法看小說，會很無聊的TT"

    # 關鍵分支選項
    menu:
        "要怎麼做？"

        "不管了，就這樣不帶手機出門吧！":
            jump go_outside_without_phone

        "不行！無聊的話就死了，就算遲到也要等它充一點電！":
            jump wait_for_charge
# ==============================================================================
# 分支 B：選擇等待充電（觸發壞結局並開啟輪迴）
# ==============================================================================
label wait_for_charge:

    mc "不行不行！沒有手機就太無聊了……"
    "我焦急地坐在床邊盯著螢幕上的充電圖示。"

    "時間一分一秒過去，世界彷彿逐漸褪去顏色，淪為一片死寂的灰白……"

    # 畫面效果：快速閃爍白光或黑屏
    scene black with fade

    "強烈的眩暈感襲來，周圍的空氣開始扭曲。"

    mc "怎麼回事……頭好暈……眼前一片漆黑……"

    # 增加持久變數的輪迴次數
    $ persistent.loop_count += 1

    # 自動強制重新開始遊戲（跳回 label start）
    renpy.full_restart()

# ==============================================================================
# 分支 A：不帶手機出門（通往主線）
# ==============================================================================
label go_outside_without_phone:

        mc "算了！不就是一天沒手機嗎？"

           "我穿好衣服後推開了家門。"

    # 成功進入主線後，可以選擇重置輪迴計數（或保留作為紀錄）
    $ persistent.loop_count = 0

    "（踏上校園之旅……）"

    # --------------------------------------------------------------------------
    # 第一節：上學路上的風景（現實與虛擬的強烈對比）
    # --------------------------------------------------------------------------
    scene bg street_morning with fade

    "我背著書包，邁開步伐走在熟悉的上學街道上。"

    "因為沒有手機可以看，我的視線無處安放，只能被向周圍的世界。"

    "「……好安靜。」這是我腦海中的第一個想法"

    "迎面走來的上班族、穿著不同校服的學生……數百人擠在窄小的行人路上面對面交錯"

    "一些人微低著頭"

    "他們的雙眼注視著手機上的光芒"

    mc "平時的我……也是這副樣子嗎？"

    "走了一段路看見了熟悉的公園"

    "那裏十分清幽，什麼人也沒有，在返學時段應該很正常的吧"

    "為了打法無聊，我開始想像一些問題"

    "話說為什麼那些重生者或者穿越者都會變得和以前不一樣？"
    "明明以前還是個膽小的人"
    "但那些小說或者動畫的人穿越重新了就會做平時不會做的事"
    "我想是因為已經知道了未來的走向吧"
    "這麼說來要問我什麼事害怕的話可能就是未知吧"

    "不知不覺已經到了學校門口"

    "這裏的人衣著都一樣，除了男女分別之外，和監獄有點點相似呢，我不禁會心一笑"

    "老師再講台上說話，

    "我嘗試著向她開口，指了指腳邊的花。"

    "然而，女生完全沒有聽到我的聲音。她戴著降噪耳機，雙眼緊盯著虛擬社交介面上跳動的讚數，僵硬地從那朵花上踩了過去。"

    "那朵原本鮮豔的花朵瞬間被踩得粉碎。"

    mc "……"

    "這份沒有人理會的孤獨感突然湧上心頭。"

    "但也正因為沒有手機的遮蔽，我第一次注意到天空原來藍得這麼澈底，風吹在臉上的感覺原來這麼真實。"

    "這個世界明明色彩斑斕，大家卻寧願把靈魂囚禁在一塊幾吋大的黑色玻璃裡。"


    # --------------------------------------------------------------------------
    # 第二節：踏入校園與課堂異樣（荒謬的現實現象）
    # --------------------------------------------------------------------------
    scene bg classroom with fade

    # 教室鐘聲響起音效
    # play sound "school_bell.ogg"

    "好不容易踩著鐘聲走進教室，映入眼簾的景象更讓我感到一陣惡寒。"

    "講台上，老師正對著空氣揮舞著手勢，根本沒有看向講台下的任何一個學生。"

    "而座位的同學，沒有任何一個人抬頭聽課。"

    "隔壁桌的同桌明明就坐在離我不足一米的地方"

    "【通知：您的同桌向您發送了一條訊息：『喂，今天早上的作業寫完沒？』】"

    mc "（轉頭看向同桌）"

    "同桌依然低著頭，手指在桌子底下瘋狂敲擊，連眼神都懶得移過來。"

    "我苦笑了一聲，直接用嘴巴向他開口："

    mc "我沒帶手機，今天沒辦法傳檔案給

   

    mc "（輕聲自語）這群傢伙……到底病得有多重啊。"

    "無法忍受這種窒息氛圍的我，趁著老師完全不注意講台下的空檔，悄悄從後門溜了出去。"

    "既然這個教室已經被虛擬世界吞噬……"

    "那我不如去尋找這座學校裡，是否還存在著真正的「現實」。"

    # 續接後續：遇見第一位女主角（舊神社/武道館/畫室等）
    # jump chapter_1_first_heroine

    
